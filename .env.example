# Frontend — values safe for the browser
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Public VAPID key. Leave empty until a Web Push provider is configured.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=

# Backend — never expose these values to the browser
PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://user:password@host:5432/postgres
DIRECT_URL=postgresql://user:password@host:5432/postgres
DATABASE_POOL_MAX=5
DATABASE_TRANSACTION_TIMEOUT_MS=15000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
PASSWORD_RECOVERY_REDIRECT_URL=http://localhost:3000/reset-password
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:contato@example.com
# Secret shared only with the production scheduler.
CRON_SECRET=replace-with-a-long-random-secret
